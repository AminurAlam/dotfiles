// MISC

window-rule { // popup => focus
    match title="^file_chooser$"
    match title="ChiPass - Browser Access Request"

    open-focused true
}


// SIZING

window-rule { // => maximized
    match app-id="librewolf|vesktop|newsraft" is-floating=false
    match app-id="org.kde.kdeconnect.app" title="KDE Connect" is-floating=false
    match app-id="org.musicbrainz.Picard" title="MusicBrainz Picard" is-floating=false

    open-maximized-to-edges true
}

window-rule { // => fullscreen
    match app-id="^org.gnome.gitlab.YaLTeR.Identity$"

    open-fullscreen true
}

window-rule { // => floating
    match app-id="^foot$" title="^float$"
    match title="ChiPass - Browser Access Request"

    open-floating true
}

window-rule { // mpv-music => fixed size
    match app-id="^mpv$" title="\\.flac$"

    open-floating true
    default-floating-position x=1710 y=10
    max-width 200
    max-height 200
}

window-rule { // scrcpy => fixed size
    match app-id="scrcpy"

    default-column-width { fixed 475; }
}


// WINDOW FOCUS

window-rule { // * =>

    geometry-corner-radius 12
    clip-to-geometry true
    background-effect { blur true; }
}

window-rule { // unfocused => opacity
    match is-focused=false
    exclude app-id="^mpv$"
    exclude app-id="librewolf" title="Picture-in-Picture" is-floating=true

    opacity 0.9
}

window-rule { // floating => ring->border
    match is-floating=true

    focus-ring { off; }
    border { on; }
}


// LAYER BLUR

layer-rule { // notifications|launcher
    match namespace="^notifications$"
    match namespace="^launcher$"

    opacity 0.9
    background-effect { blur true; xray false; }
}

layer-rule { // waybar
    match namespace="^waybar$"

    opacity 0.95
    background-effect { blur true; }
}

layer-rule { // backdrop
    match namespace="waybar|wallpaper"
    match at-startup=true

    place-within-backdrop true
}
