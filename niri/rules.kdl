// MISC

window-rule { // focus on popups
    match title="^file_chooser$"
    match title="^KeePassXC - (Browser Access Request|ブラウザーのアクセス要求)$"

    open-focused true
}


// SIZING

window-rule { // maximized
    match app-id="librewolf|vesktop|newsraft" is-floating=false
    match app-id="^(org|com)\\..*\\.(Picard|kdeconnect.app)$" is-floating=false

    open-maximized-to-edges true
}

window-rule { // fullscreen
    match app-id="^org.gnome.gitlab.YaLTeR.Identity$"

    open-fullscreen true
}

window-rule { // floating
    match app-id="^foot$" title="^float$"

    open-floating true
}

window-rule { // fixed size: mpv music
    match app-id="^mpv$" title="\\.flac$"

    open-floating true
    default-floating-position x=1710 y=10
    max-width 200
    max-height 200
}

window-rule { // fixed size: sc mirror
    match app-id="scrcpy"

    default-column-width { fixed 475; }
}


// WINDOW FOCUS

window-rule { // *

    geometry-corner-radius 12
    clip-to-geometry true
    background-effect { blur true; }
}

window-rule { // unfocused
    match is-focused=false
    exclude app-id="^mpv$"

    // TODO: draw border
    opacity 0.9
}

window-rule { // focused
    match is-focused=true

    opacity 1.0
    border
    focus-ring { on; }
}


// LAYER BLUR

layer-rule { // notifications
    match namespace="^notifications$"

    opacity 0.9
    background-effect { blur true; xray false; }
}

layer-rule { // launcher
    match namespace="^launcher$"

    opacity 0.9
    background-effect { blur true; xray false; }
}

layer-rule { // waybar
    match namespace="^waybar$"

    opacity 0.95
    background-effect { blur true; }
}

layer-rule { // backdrop
    match namespace="waybar|wallpaper"
    match at-startup=true

    place-within-backdrop true
}
