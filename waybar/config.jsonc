{
  "layer": "top",
  "spacing": 4,
  "modules-left": [
    "niri/workspaces",
    "custom/columns",
  ],
  "modules-center": ["tray"],
  "modules-right": [
    // "mpd",
    // "keyboard-state",
    "pulseaudio",
    // "backlight",
    "network",
    // "battery#bat2",
    "memory",
    "cpu",
    "temperature",
    "custom/brick",
    "battery",
    "power-profiles-daemon",
    // "idle_inhibitor",
    // "privacy",
    "clock",
  ],
  "niri/workspaces": {
    "format": " {icon} ",
  },
  "niri/window": {
    "format": "",
    "icon": true,
  },
  "custom/columns": {
    "exec": "niri-columns",
    "return-type": "string",
    "restart-interval": "never",
    "format": "{} ",
  },
  "niri/language": {
    "format": "{short}",
  },
  "tray": {
    "icon-size": 25,
    "spacing": 15,
    "reverse-direction": true,
  },
  "pulseaudio": {
    "format": "{icon} {format_source}",
    "format-bluetooth": "{icon} {format_source}",
    "format-bluetooth-muted": "{icon} {format_source}",
    "format-muted": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "󱡏",
      "hands-free": "󱡏",
      "headset": "󱡏",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },
  "backlight": {
    "format": "{icon} {percent}",
    "format-icons": ["󰃟"],
    "tooltip": false,
  },
  // https://github.com/Alexays/Waybar/wiki/Module:-Network
  "network": {
    "interface": "wlan0",
    "interval": 1,
    "format-disconnected": "󰤭",
    "format-disabled": "",
    "format-wifi": " {bandwidthTotalBytes}  {icon} {essid}", // TODO: put {:i} after update
    "tooltip-format-wifi": "{essid}: {ipaddr}/{cidr}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "{bandwidthTotalBytes} 󰈀",
    "format-linked": "{icon} {essid} {bandwidthTotalBytes}",
    "tooltip-format": "{essid} {gwaddr}",
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 5,
    "consume-icons": { "on": " " },
    "random-icons": { "off": "<span color=\"#f53c3c\"></span> ", "on": " " },
    "repeat-icons": { "on": " " },
    "single-icons": { "on": "1 " },
    "state-icons": { "paused": "", "playing": "" },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)",
  },
  "memory": {
    "interval": 5,
    "format": " {}%",
    "max-length": 10,
    "states": {
      "warning": 80,
      "critical": 90,
    },
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 1,
    "tooltip": true,
    "states": { "high": 30, "low": 0 },
  },
  "temperature": {
    "critical-threshold": 55,
    "format": " {temperatureC}°",
    "tooltip": false,
  },
  "custom/brick": {
    "exec": ".config/waybar/brick.fish",
    "return-type": "json",
    "restart-interval": "never",
    "hide-empty-text": true,
    "format": " {percentage}%",
    "states": { "critical": 20, "warning": 40, "good": 75, "full": 100 },
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-charging": " {capacity}% ",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} | {cycles} cycles | {power} watts",
    "format-icons": ["", "", "", "", "", ""],
    "interval": 5,
    "states": { "critical": 20, "warning": 40, "good": 75, "full": 100 },
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
    "tooltip": false,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "󰒲" },
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 18,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
      {
        "type": "audio-out",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
    ],
  },
  "clock": {
    "locale": "en_GB.UTF-8",
    "interval": 30,
    "format": "{:%a %b %d %H:%M}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'>{}</span>",
        "days": "<span color='#c0caf5'>{}</span>",
        "weekdays": "<span color='#ffcc66'><small>{}</small></span>",
        "today": "<span background='#8db0ff' color='#1d202f'>{}</span>",
      },
    },
  },
}
