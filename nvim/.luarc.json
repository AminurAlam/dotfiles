{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "completion": {
    "callSnippet": "Replace",
    "displayContext": 5
  },
  "diagnostics": {
    "disable": ["lowercase-global"],
    "globals": ["_G", "vim"],
    "libraryFiles": "Disable",
    "unusedLocalExclude": ["_*"]
  },
  "format": { "enable": true },
  "hint": { "enable": true },
  // TODO: replace with vim.api.nvim_get_runtime_file('', true)
  "library": [
    "~/.config/nvim",
    "/etc/xdg/nvim",
    "~/.local/share/nvim/site",
    "~/.local/share/nvim/site/pack/core/opt/conform.nvim",
    "~/.local/share/nvim/site/pack/core/opt/nvim-treesitter",
    "~/.local/share/nvim/site/pack/core/opt/mini.pick",
    "~/.local/share/nvim/site/pack/core/opt/mini.diff",
    "~/.local/share/nvim/site/pack/core/opt/mini.completion",
    "~/.local/share/nvim/site/pack/core/opt/dial.nvim",
    "~/.local/share/nvim/site/pack/core/opt/nvim-surround",
    "~/.local/share/nvim/site/pack/core/opt/tokyonight.nvim",
    "~/.local/share/nvim/site/pack/core/opt/nvim-colorizer.lua",
    "~/.local/share/nvim/site/pack/core/opt/ultimate-autopair.nvim",
    "~/.local/share/nvim/site/pack/core/opt/full_visual_line.nvim",
    "/usr/share/nvim/runtime",
    "/usr/lib/nvim",
    "~/.config/nvim/after",
    "/usr/share/vim/vimfiles"
  ],
  "runtime": {
    "path": ["lua/?.lua", "lua/?/init.lua"],
    "version": "LuaJIT"
  },
  "semantic": { "enable": false },
  "telemetry": { "enable": false },
  "type": { "castNumberToInteger": false },
  "typeFormat": {
    "config": {
      "auto_complete_end": "true",
      "format_line": "false"
    }
  },
  "window": { "progressBar": true },
  "workspace": {
    "checkThirdParty": "Disable",
    "library": ["lua", "$VIMRUNTIME", "${3rd}/luv/library"]
  }
}
